Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", "Hamiltonian", " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"H0", "[", "\[CapitalOmega]_", "]"}], ":=", "  ", 
     RowBox[{"\[CapitalOmega]", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "0"}], "}"}]}], "}"}]}]}], ";"}], "\n", "\n", 
   RowBox[{"(*", " ", "Observable", " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"oX", "[", "\[Theta]_", "]"}], ":=", "  ", 
     RowBox[{
      RowBox[{
       RowBox[{"Cos", "[", "\[Theta]", "]"}], "*", 
       RowBox[{"PauliMatrix", "[", "1", "]"}]}], " ", "+", " ", 
      RowBox[{
       RowBox[{"Sin", "[", "\[Theta]", "]"}], "*", 
       RowBox[{"PauliMatrix", "[", "3", "]"}]}]}]}], ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"Parametrization", " ", "density", " ", "matrix"}], " ", "*)"}], 
   "\n", 
   RowBox[{
    RowBox[{"rho", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         SubscriptBox["r", "ee"], ",", 
         RowBox[{"ru", "-", 
          RowBox[{"I", " ", "rv"}]}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"ru", "+", 
          RowBox[{"I", " ", "rv"}]}], ",", 
         RowBox[{"1", "-", 
          SubscriptBox["r", "ee"]}]}], "}"}]}], "}"}]}], ";"}], "\n", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"**", " ", "Jump"}], " ", "operator", " ", "clock", " ", 
     "subspace"}], "***)"}], "\n", 
   RowBox[{
    RowBox[{"Lw", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "0"}], "}"}]}], "}"}]}], ";"}], " ", "\n", 
   RowBox[{
    RowBox[{"Lwd", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0"}], "}"}]}], "}"}]}], ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Vectorization", " ", "of", " ", "the", " ", "tilted", " ", "Liouvillian",
      " ", "generator"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"ldss", "[", 
     RowBox[{
     "\[CapitalOmega]_", ",", "\[Gamma]m_", ",", "\[Gamma]w_", ",", 
      "\[Theta]_", ",", "s_"}], "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "}"}], ",", "\n", "                       ", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "\[ImaginaryI]"}], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"KroneckerProduct", "[", 
           RowBox[{
            RowBox[{"H0", "[", "\[CapitalOmega]", "]"}], ",", 
            RowBox[{"IdentityMatrix", "[", "2", "]"}]}], "]"}], "-", " ", 
          "\n", "                           ", 
          RowBox[{"KroneckerProduct", "[", 
           RowBox[{
            RowBox[{"IdentityMatrix", "[", "2", "]"}], ",", 
            RowBox[{"Transpose", "[", 
             RowBox[{"H0", "[", "\[CapitalOmega]", "]"}], "]"}]}], "]"}]}], 
         ")"}]}], "\n", "                       ", "-", 
       RowBox[{"\[Gamma]m", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"KroneckerProduct", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"oX", "[", "\[Theta]", "]"}], ".", 
             RowBox[{"oX", "[", "\[Theta]", "]"}]}], ",", 
            RowBox[{"IdentityMatrix", "[", "2", "]"}]}], "]"}], "\n", 
          "                            ", "-", " ", 
          RowBox[{"2", " ", 
           RowBox[{"KroneckerProduct", "[", 
            RowBox[{
             RowBox[{"oX", "[", "\[Theta]", "]"}], ",", 
             RowBox[{"Transpose", "[", 
              RowBox[{"oX", "[", "\[Theta]", "]"}], "]"}]}], "]"}]}], "\n", 
          "                            ", "+", " ", 
          RowBox[{"KroneckerProduct", "[", 
           RowBox[{
            RowBox[{"IdentityMatrix", "[", "2", "]"}], ",", 
            RowBox[{"Transpose", "[", 
             RowBox[{
              RowBox[{"oX", "[", "\[Theta]", "]"}], ".", 
              RowBox[{"oX", "[", "\[Theta]", "]"}]}], "]"}]}], "]"}]}], 
         ")"}]}], "\n", "                       ", "+", 
       RowBox[{"\[Gamma]w", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"Exp", "[", 
            RowBox[{"-", "s"}], "]"}], " ", 
           RowBox[{"KroneckerProduct", "[", 
            RowBox[{"Lw", ",", 
             RowBox[{"Transpose", "[", "Lwd", "]"}]}], "]"}]}], " ", "\n", 
          "                             ", "-", " ", 
          RowBox[{
           FractionBox["1", "2"], 
           RowBox[{"(", " ", 
            RowBox[{
             RowBox[{"KroneckerProduct", "[", 
              RowBox[{
               RowBox[{"Lwd", ".", "Lw"}], ",", " ", 
               RowBox[{"IdentityMatrix", "[", "2", "]"}]}], "]"}], " ", "\n", 
             "                             ", "+", " ", 
             RowBox[{"KroneckerProduct", "[", 
              RowBox[{
               RowBox[{"IdentityMatrix", "[", "2", "]"}], ",", 
               RowBox[{"Transpose", "[", 
                RowBox[{"Lwd", ".", "Lw"}], "]"}]}], "]"}]}], " ", ")"}]}]}], 
         ")"}]}]}]}], "                      ", "\n", 
     "                       ", "]"}]}]}]}]], "Code",
